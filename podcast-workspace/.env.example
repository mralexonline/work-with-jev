# Copy to .env (never commit it). All values optional unless noted. No secret has a default.

# --- Owner auth (REQUIRED for any non-local use). If unset, a random token is generated once into
#     data/owner_token (mode 0600); show it with:  python -m app.cli show-token
# OWNER_TOKEN=

# --- Server
HOST=127.0.0.1            # keep 127.0.0.1 and put an HTTPS reverse proxy in front (docs/SETUP.md)
PORT=8000
DATA_DIR=./data           # persistent volume in production: SQLite queue, projects, exports
# ALLOWED_ORIGINS=https://workspace.example.com    # exact public origin(s) behind your proxy

# --- Spending controls (CAD). The app refuses to approve past these. Also set the provider-side limit.
MONTHLY_BUDGET_CAD=100
SOFT_ALERT_PCT=0.8
PER_JOB_CAP_CAD=25
USD_PER_CAD=0.72          # UPDATE to today's rate; the app cannot know it

# --- Queue
MAX_ATTEMPTS=3            # bounded retries per job
RETRY_BASE_S=5
RETRY_CAP_S=300
LEASE_S=60

# --- Terminal (off by default; owner-only when on)
ENABLE_TERMINAL=0
TERMINAL_IDLE_S=900
# TERMINAL_CMD="docker run --rm -it --network=none --user 1000 -v pw-term:/work python:3.11-slim bash"   # stronger isolation

# --- Cloud GPU (Modal). Stays off until you have read docs/COSTS.md and approved the spend.
CLOUD_ENABLED=0
MODAL_APP_NAME=podcast-workspace
# Modal reads MODAL_TOKEN_ID / MODAL_TOKEN_SECRET (or ~/.modal.toml). Keep them OUT of this file on shared hosts.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# --- Script-writing LLM (needed for episodes > 60 s). Pick ONE.
# OpenAI-compatible (OpenAI, OpenRouter, vLLM, Ollama...):
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=model-name
# LLM_API_KEY=
# Anthropic Messages API:
# ANTHROPIC_API_KEY=
# LLM_MODEL=model-name

# --- Public resource access (optional, raises rate limits / needed for gated models)
# HF_TOKEN=
# GITHUB_TOKEN=             # read-only, public_repo scope only
